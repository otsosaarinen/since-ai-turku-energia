# The ONE settings file of the project. Copy to `.env` (git-ignored) and fill in. Real environment variables override this file.
# Read by the Python harness (backend/harness) and, for the NEXT_PUBLIC_ lines, by the Next.js frontend (frontend/next.config.ts).
# On Vercel there is no .env file: set the NEXT_PUBLIC_ variables in the project's Environment Variables instead.

# --- Harness API keys (backend). The website's Settings box can also save them here. ---
# Fingrid open-data API key (https://data.fingrid.fi)
FINGRID_API_KEY=
# ENTSO-E Transparency Platform security token
ENTSOE_API_KEY=

# --- Frontend ---
# true (or 1) hides the Harness tab, panel and proxy completely. Use it on the hosted demo.
NEXT_PUBLIC_HIDE_HARNESS=false
# Where the website loads the forecast JSON files from. Default /data = frontend/public/data. An external address must allow cross-origin GET (CORS).
# NEXT_PUBLIC_DATA_BASE_URL=/data
# NEXT_PUBLIC_ variables are baked in at build time: after changing one, rebuild or redeploy.

# --- Optional harness settings (uncomment to change) ---
# By default every model the Llama app lists is offered. To restrict the list, give words a model id must contain (comma-separated)
# HARNESS_MODEL_FILTER=E4B,12B
# Address of the local OpenAI-style model server (the Llama app)
# LLAMACPP_BASE_URL=http://localhost:9931/v1
# Port of the harness control server
# HARNESS_SERVER_PORT=8765
# Seconds between live-alert polls
# ALERT_POLL_S=300
